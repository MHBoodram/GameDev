~ start
Cesti: [[Hi|I bid thee|Good evening bartender]], My Order is {{drink_list}}
do _add_recipt()
set speaking_title = "mid"
=> END
~ mid
Cesti: [[I am awaiting my drink sir|Why keep talking if the drink isn't ready?]]
=> END
~ finish
Cesti: Finished
=> END



~ Positive
set emo = "happy"
Cesti: Didn't know ambrosia was made here
Cesti: I thank you for the service sir
do _give_payment()
=> END

~ Negative
set emo = "mad"
Cesti: I didn't live 1000 years to drink total sludge
do _give_payment()
=> END

~ Mid
Cesti: This will do good sir
do _give_payment()
=> END

~ TimeWarning1
Cesti: I've been alive for millenia, I will not wait any longer for a good drink
=> END
